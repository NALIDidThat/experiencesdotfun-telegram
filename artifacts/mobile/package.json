{
  "name": "@workspace/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "CI=1 EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=${Google_Maps_API:-$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY} EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID pnpm exec expo start --web --localhost --port $PORT",
    "build": "node scripts/build-web.js",
    "serve": "node server/serve.js",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run test:auth && pnpm run test:organisation-onboarding-copy && pnpm run test:solana-pay && pnpm run test:campaign-tracker && pnpm run test:campaign-list && pnpm run test:location-resolution && pnpm run test:memory-game && pnpm run test:home-priority",
    "test:e2e": "pnpm run test:auth && pnpm run test:home-prompt && pnpm run test:host && pnpm run test:keyboard && pnpm run test:explore",
    "test:auth": "node --test --test-concurrency=1 scripts/email-signup-login.test.mjs",
    "test:organisation-onboarding-copy": "node --experimental-strip-types --test scripts/organisation-onboarding-copy.test.mjs",
    "test:home-priority": "node --experimental-strip-types --test scripts/home-priority.test.mjs",
    "test:home-prompt": "node --test scripts/home-prompt-interaction.test.mjs",
    "test:host": "node --test --test-concurrency=1 scripts/host-management-interaction.test.mjs",
    "test:solana-pay": "node --test scripts/solana-pay.test.mjs",
    "test:campaign-tracker": "node --test components/fundraising/format-sol.test.mjs",
    "test:campaign-list": "node --test components/fundraising/campaign-list.test.mjs",
    "test:keyboard": "node --test scripts/keyboard-interaction.test.mjs",
    "test:explore": "node --test scripts/explore-globe-interaction.test.mjs",
    "test:location-resolution": "node --experimental-strip-types --test scripts/location-resolution.test.mjs",
    "test:memory-game": "node --test scripts/memory-game-review.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.3.6",
    "expo": "~57.0.28",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@types/google.maps": "^3.66.5",
    "@vis.gl/react-google-maps": "^1.10.1",
    "expo-clipboard": "~57.0.2",
    "react-native-webview": "13.16.1"
  }
}
